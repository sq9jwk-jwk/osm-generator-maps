# /etc/osm-tilegen/config.toml

[server]
host = "0.0.0.0"
port = 8080

[paths]
data_dir      = "/var/lib/osm-tilegen"
styles_dir    = "/usr/share/osm-tilegen/styles"
frontend_dist = "/usr/share/osm-tilegen/ui"

[import]
tilemaker_bin = "tilemaker"
osmium_bin    = "osmium"
# Defaults: the profile bundled with osm-tilegen (/usr/share/osm-tilegen/tilemaker).
# tilemaker_config  = "/usr/share/osm-tilegen/tilemaker/config.json"
# tilemaker_process = "/usr/share/osm-tilegen/tilemaker/process.lua"
# Low-RAM machines (Raspberry Pi): keep tilemaker's working data on disk.
store_on_disk = false
coverage_zoom = 10

[limits]
# Heavy jobs (import, render) use at most this share of CPU cores, so the machine stays
# usable. Sets tilemaker/render threads; postinst also writes a systemd CPUQuota from it.
max_cpu_percent = 80

[render]
# "debug" draws z/x/y test tiles; "maplibre" = real rendering (after spike M0.5)
engine  = "debug"
threads = 0   # 0 = derived from [limits] max_cpu_percent
