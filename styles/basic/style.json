{
  "version": 8,
  "name": "Podstawowy (bez etykiet)",
  "metadata": {
    "osm-tilegen:note": "Built-in minimal style for the OpenMapTiles schema produced by tilemaker. No glyphs or sprites needed, so it works offline out of the box."
  },
  "sources": {
    "openmaptiles": { "type": "vector", "url": "local" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f2efe9" } },
    { "id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["wood", "forest"]]],
      "paint": { "fill-color": "#cfe3c1" } },
    { "id": "landcover-grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "meadow", "farmland"]]],
      "paint": { "fill-color": "#e6eed5" } },
    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "neighbourhood"]]],
      "paint": { "fill-color": "#e6e1d8" } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#d4e8c4" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#a8cbe8" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#a8cbe8", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 3] } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13,
      "paint": { "fill-color": "#d9d0c7", "fill-outline-color": "#c4b8ac" } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track", "path"]]],
      "minzoom": 12,
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 8] } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "paint": { "line-color": "#fff3b0", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 18, 12] } },
    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["primary", "trunk"]]],
      "paint": { "line-color": "#fcd68a", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 18, 14] } },
    { "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": { "line-color": "#e892a2", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 18, 16] } },
    { "id": "railway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"],
      "paint": { "line-color": "#999999", "line-width": 1, "line-dasharray": [3, 3] } },
    { "id": "boundary", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 4],
      "paint": { "line-color": "#9e7fa8", "line-width": 1.2, "line-dasharray": [4, 2] } }
  ]
}
